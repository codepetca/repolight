# Default deny: only explicit build inputs can enter the context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!.node-version
!next.config.js
!next-env.d.ts
!tsconfig.json
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/report-worker.ts
!scripts/build-worker.mjs

# Defensive exclusions also cover nested files inside the permitted trees.
**/.verification
**/.verification/**
**/.env*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/output
**/output/**
**/exports
**/exports/**
**/dist
**/dist/**
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/password
**/password.*
**/*credentials*
**/*secret*
