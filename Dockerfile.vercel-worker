# syntax=docker/dockerfile:1
# Vercel Daemons build the final stage; the web app uses Vercel's Next.js build.
FROM node:22.23.4-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json .node-version ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
COPY scripts/report-worker.ts scripts/build-worker.mjs ./scripts/
RUN npm run build:worker

FROM node:22.23.4-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/dist/report-worker.cjs ./dist/report-worker.cjs
USER node
CMD ["node", "dist/report-worker.cjs", "--poll"]
