# Neon Postgres connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Required for production cookie mutations. Exact externally visible HTTPS origin.
APP_ORIGIN="https://repolight.example"

# At least 32 characters. Used to seal auth session cookies.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional. Raises GitHub API rate limits for public repository analysis.
GITHUB_TOKEN=""

# Optional public-analysis GitHub App. All three must be configured together.
# Use a minimally scoped installation; private repositories are still rejected.
REPOLIGHT_GITHUB_APP_ID=""
REPOLIGHT_GITHUB_APP_INSTALLATION_ID=""
REPOLIGHT_GITHUB_APP_PRIVATE_KEY=""

# Vercel-only on-demand analysis. Use true on the approved deployment; keep
# previews off unless they have isolated DB/GitHub credentials. Local CLI is separate.
REPOLIGHT_ON_DEMAND_WORKER_ENABLED="false"

# Legacy classroom provisioning only; not needed for public repository reports.
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Optional. Enables private server-to-server API access under /api/v1.
REPOCAT_API_KEY=""
REPOCAT_API_KEYS=""
REPOCAT_API_USER_EMAIL="api@repocat.local"

# Optional owner-requested interpretation. Disabled by default; no model fallback.
# See docs/AI-INTERPRETATION.md before authorized paid-provider activation.
REPOLIGHT_AI_ENABLED="false"
REPOLIGHT_AI_MODEL=""
REPOLIGHT_OPENAI_API_KEY=""
